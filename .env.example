# Copy this file to .env and fill in your own values. .env is git-ignored — never commit real keys.

# Twilio SMS gateway (used by the "Twilio" provider on the SMS Alerts page)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional: where the Python backend runs (default http://127.0.0.1:5000)
# API_URL=http://127.0.0.1:5000
